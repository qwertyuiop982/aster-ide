{
  "brackets": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ],
    [
      "'",
      "'"
    ]
  ],
  "surroundingPairs": [
    [
      "{",
      "}"
    ],
    [
      "[",
      "]"
    ],
    [
      "(",
      ")"
    ],
    [
      "\"",
      "\""
    ]
  ],
  "comments": {
    "lineComment": "#"
  },
  "indentationRules": {
    "increaseIndentPattern": "^.*(?:\\{[^}]*|\\([^)]*|\\[[^\\]]*|:)\\s*$",
    "decreaseIndentPattern": "^\\s*[}\\])].*$"
  }
}